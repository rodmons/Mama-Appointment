# Copy to .env for local development. Never commit the real .env file.
# Find both values in the Supabase project's Connect dialog or API settings.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Older Supabase projects can use VITE_SUPABASE_ANON_KEY instead. Never use a
# secret key or service_role key in this browser application.
